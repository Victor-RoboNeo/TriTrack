# Copy to scripts/sync_remotes.env and fill in. That file is gitignored.
#   cp scripts/sync_remotes.env.example scripts/sync_remotes.env
#
# GitHub token: https://github.com/settings/tokens  (scope: repo)
# ModelScope token: https://modelscope.cn/my/myaccesstoken

# ---------- GitHub (code) ----------
GITHUB_USER="YOUR_GITHUB_USERNAME"
GITHUB_TOKEN="YOUR_GITHUB_TOKEN"
GITHUB_REPO="Anybody"
GITHUB_PRIVATE="1"
# 1 = git add + commit dirty files, then push. 0 = push existing commits only.
GITHUB_COMMIT="1"
GITHUB_COMMIT_MESSAGE=""

# ---------- ModelScope (data + ckpts) ----------
MODELSCOPE_USER="YOUR_MODELSCOPE_USERNAME"
MODELSCOPE_TOKEN="YOUR_MODELSCOPE_TOKEN"
MODELSCOPE_DATASET="Anybody-data"
MODELSCOPE_MODEL="Anybody-ckpts"
# public | private | internal
MODELSCOPE_VISIBILITY="private"

# CLI used for upload (this machine already has it in humanego)
MODELSCOPE_BIN="/data/home/chenxiangyu/miniconda3/envs/humanego/bin/modelscope"

# ---------- what to upload ----------
# bones-seed is ~389GB and already on ModelScope (bones-studio/seed). Keep 0.
INCLUDE_BONES_SEED="0"
UPLOAD_DATASETS="1"
UPLOAD_CKPTS="1"
UPLOAD_RESULTS="1"
UPLOAD_EXPORTS="1"

# ---------- optional proxy (leave empty if unused) ----------
HTTP_PROXY=""
HTTPS_PROXY=""
# HTTP_PROXY="http://127.0.0.1:7890"
# HTTPS_PROXY="http://127.0.0.1:7890"
