# =============================================================================
# GitHub = code only. Data / checkpoints / wandb live on ModelScope.
# Secrets never leave this machine via git.
# =============================================================================

# --- credentials / local sync config ---
scripts/sync_remotes.env
**/.env
**/.env.*
!**/.env.example
!**/*.env.example
**/secrets/

# --- datasets, checkpoints, experiment dumps ---
datasets/
logs/
results/
outputs/
exports/
wandb/
**/runs/
**/recordings/
**/videos/

